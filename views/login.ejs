<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= kind==='admin'?'Admin':'Vendor' %> login · Neighbourhood</title><link rel="stylesheet" href="/portal.css"></head><body class="portal-body"><main class="auth-wrap"><a class="logo" href="/">n.<span>neighbourhood<small>GOOD FOOD, BETTER CONVERSATIONS</small></span></a><section class="auth-card"><span class="eyebrow"><%= kind==='admin'?'PLATFORM MANAGEMENT':'YOUR STALL, YOUR SPACE' %></span><h1><%= kind==='admin'?'Admin sign in':'Welcome back.' %></h1><p><%= kind==='admin'?'Sign in to manage vendors, reviews and platform activity.':'Sign in to update your stall page, manage your menu and read customer feedback.' %></p><% if(flash){ %><div class="notice"><%= flash %></div><% } %><form method="post" action="/<%= kind %>/login"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Email address<input type="email" name="email" required autocomplete="username"></label><label>Password<input type="password" name="password" required autocomplete="current-password"></label><button class="dark-btn full">Sign in ↗</button></form><a class="back-link" href="/">← Back to main website</a></section></main></body></html>
