<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Admin dashboard · Neighbourhood</title><link rel="stylesheet" href="/portal.css"></head><body class="dashboard-body"><aside class="sidebar admin-sidebar"><a class="logo" href="/">n.<span>neighbourhood<small>PLATFORM ADMIN</small></span></a><div class="side-label">MANAGEMENT</div><a href="#overview">Dashboard</a><a href="#vendors">All vendors</a><a href="#add-vendor">Add a vendor</a><a href="#all-reviews">All feedback</a><a href="#settings">Settings</a><div class="side-bottom"><a href="/">View public website ↗</a><a href="/admin/logout">Sign out ↗</a></div></aside><main class="dash-main"><header class="dash-top"><div><span class="eyebrow">PLATFORM OVERVIEW</span><h1>Good evening, <%= user.name %>.</h1></div><a class="outline-btn" href="/">Open main website ↗</a></header><% if(flash){ %><div class="notice"><%= flash %></div><% } %><section id="overview" class="stat-grid"><div class="stat-card"><small>TOTAL VENDORS</small><b><%= totals.vendors %></b><span><%= totals.active %> currently public</span></div><div class="stat-card"><small>CUSTOMER FEEDBACK</small><b><%= totals.reviews %></b><span>Responses across all stalls</span></div><div class="stat-card"><small>PLATFORM RATING</small><b><%= totals.avg %> <i>★</i></b><span>Average of all reviews</span></div></section>
<section class="dash-panel" id="vendors"><div class="panel-heading"><div><span class="eyebrow">YOUR DIRECTORY</span><h2>All vendors</h2><p>Manage vendor access, visibility and accounts. The two starter login IDs are <b>ramesh@neighbourhood.local</b> and <b>prakash@neighbourhood.local</b>; set their passwords with “Reset password” before sharing access.</p></div><a class="outline-btn" href="/admin/export/feedback.csv">Export feedback CSV ↓</a></div><div class="table-wrap"><table><thead><tr><th>Vendor</th><th>Login email</th><th>Menu</th><th>Reviews</th><th>Rating</th><th>Status</th><th>Actions</th></tr></thead><tbody><% vendors.forEach(v=>{ %><tr><td><b><%= v.name %></b><small><%= v.owner_name %> · /v/<%= v.slug %></small><a class="table-link" href="/v/<%= v.slug %>" target="_blank">Open public page ↗</a></td><td><%= v.email %></td><td><%= v.menu_count %></td><td><%= v.review_count %></td><td><%= v.avg_rating||'—' %> ★</td><td><span class="status <%= v.active?'on':'off' %>"><%= v.active?'Public':'Hidden' %></span></td><td><div class="action-stack"><form method="post" action="/admin/vendors/<%= v.id %>/status"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="active" value="<%= v.active?0:1 %>"><button class="mini-btn"><%= v.active?'Hide':'Publish' %></button></form><details><summary class="mini-btn">Reset password</summary><form method="post" action="/admin/vendors/<%= v.id %>/reset-password" class="inline-reset"><input type="hidden" name="_csrf" value="<%= csrf %>"><input name="password" type="password" minlength="10" placeholder="New password" required><button class="mini-btn">Set</button></form></details><form method="post" action="/admin/vendors/<%= v.id %>/delete" onsubmit="return confirm('Permanently delete this vendor and all its menu/review data?')"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="mini-btn danger-text">Delete</button></form></div></td></tr><% }) %></tbody></table></div></section>
<section class="dash-panel" id="add-vendor"><div class="panel-heading"><div><span class="eyebrow">GROW THE COMMUNITY</span><h2>Add another vendor</h2><p>Create the vendor's login. They can complete their own website and menu from their portal.</p></div></div><form method="post" action="/admin/vendors" class="portal-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="form-two"><label>Stall / business name<input name="name" required placeholder="Prakash's Food Corner"></label><label>Owner name<input name="owner_name" placeholder="Prakash"></label><label>Vendor email / login<input name="email" type="email" required placeholder="vendor@example.com"></label><label>Temporary password <small>(minimum 10 characters)</small><input name="password" type="password" minlength="10" required></label><label>Category<select name="category"><option>Food</option><option>Drinks</option><option>Snacks</option><option>Desserts</option><option>Other</option></select></label></div><p class="form-hint">Share the temporary password privately. The vendor should change it after signing in.</p><button class="dark-btn">Create vendor account +</button></form></section>
<section class="dash-panel" id="all-reviews"><div class="panel-heading"><div><span class="eyebrow">ALL CUSTOMER VOICES</span><h2>Platform feedback</h2><p>Responses from every vendor, newest first.</p></div></div><% reviews.forEach(r=>{ %><article class="review-card"><div class="review-top"><div><b><%= r.vendor_name %></b><small><%= r.customer_name||'Customer' %> · <%= r.created_at %> · <%= r.visit_type %></small></div><strong><%= '★'.repeat(r.rating) %><span><%= r.rating %>/5</span></strong></div><div class="review-chips"><% r.ordered.forEach(d=>{ %><span><%= d %></span><% }) %></div><div class="review-detail-grid"><% Object.entries(r.answers).filter(([k,v])=>v&&k!=='name'&&k!=='visit_date'&&k!=='visit_type').forEach(([k,v])=>{ %><div><small><%= k.replaceAll('_',' ') %></small><p><%= v %></p></div><% }) %></div></article><% }) %><% if(!reviews.length){ %><p class="empty-note">Customer feedback will appear here as people submit reviews.</p><% } %></section>
<section class="dash-panel" id="settings"><div class="panel-heading"><div><span class="eyebrow">ADMIN SECURITY</span><h2>Change admin password</h2></div></div><form method="post" action="/admin/admin-password" class="portal-form narrow"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>New password (at least 10 characters)<input type="password" name="password" minlength="10" required></label><button class="outline-btn">Update password</button></form></section><footer class="dash-footer"><a href="/">← Main website</a><span>Neighbourhood Platform Admin</span></footer></main></body></html>
