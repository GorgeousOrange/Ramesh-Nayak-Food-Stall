<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Vendor dashboard · Neighbourhood</title><link rel="stylesheet" href="/portal.css"></head><body class="dashboard-body"><aside class="sidebar"><a class="logo" href="/">n.<span>neighbourhood<small>VENDOR STUDIO</small></span></a><div class="side-label">YOUR WORKSPACE</div><a href="#overview">Overview</a><a href="#profile">Your website</a><a href="#menu">Menu manager</a><a href="#reviews">Customer reviews</a><a href="#account">Account</a><div class="side-bottom"><a href="/v/<%= vendor.slug %>" target="_blank">View public page ↗</a><a href="/vendor/logout">Sign out ↗</a></div></aside><main class="dash-main"><header class="dash-top"><div><span class="eyebrow">VENDOR WORKSPACE</span><h1>Hello, <%= vendor.owner_name||vendor.name %>.</h1></div><a class="outline-btn" href="/v/<%= vendor.slug %>" target="_blank">View your website ↗</a></header><% if(flash){ %><div class="notice"><%= flash %></div><% } %><section id="overview" class="stat-grid"><div class="stat-card"><small>YOUR REVIEWS</small><b><%= stats.count %></b><span>Customer responses</span></div><div class="stat-card"><small>AVERAGE RATING</small><b><%= stats.avg||'—' %> <i>★</i></b><span>Out of 5 stars</span></div><div class="stat-card"><small>MENU ITEMS</small><b><%= items.length %></b><span>Including unavailable items</span></div></section>
<section class="dash-panel" id="profile"><div class="panel-heading"><div><span class="eyebrow">YOUR PUBLIC PAGE</span><h2>Edit your stall website</h2><p>These details appear on your full vendor website.</p></div></div><form method="post" action="/vendor/profile" class="portal-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="form-two"><label>Stall name<input name="name" value="<%= vendor.name %>" required></label><label>Owner name<input name="owner_name" value="<%= vendor.owner_name %>"></label><label>Category<input name="category" value="<%= vendor.category %>"></label><label>Short tagline<input name="tagline" value="<%= vendor.tagline %>"></label><label>Hero heading<input name="hero_title" value="<%= vendor.hero_title %>" placeholder="Good food."></label><label>Hero subheading<input name="hero_subtitle" value="<%= vendor.hero_subtitle %>" placeholder="Good mood."></label></div><label>Short description<textarea name="description" rows="2"><%= vendor.description %></textarea></label><label>Hero paragraph<textarea name="hero_description" rows="2"><%= vendor.hero_description %></textarea></label><label>About — opening line<textarea name="story_intro" rows="2"><%= vendor.story_intro %></textarea></label><label>About — story paragraph<textarea name="story_body" rows="3"><%= vendor.story_body %></textarea></label><label>About — feedback invitation<textarea name="story_feedback" rows="2"><%= vendor.story_feedback %></textarea></label><div class="form-two"><label>Greeting<input name="greeting" value="<%= vendor.greeting %>"></label><label>Location introduction<input name="location_intro" value="<%= vendor.location_intro %>"></label><label>Address<input name="address" value="<%= vendor.address %>"></label><label>Opening hours<input name="hours" value="<%= vendor.hours %>"></label><label>Phone display<input name="phone_display" value="<%= vendor.phone_display %>"></label><label>Phone link (tel:+91...)<input name="phone_href" value="<%= vendor.phone_href %>"></label><label>Google Maps URL<input name="maps_url" value="<%= vendor.maps_url %>"></label><label>Zomato URL<input name="zomato_url" value="<%= vendor.zomato_url %>"></label><label>Swiggy URL<input name="swiggy_url" value="<%= vendor.swiggy_url %>"></label><label>Footer line<input name="footer_line" value="<%= vendor.footer_line %>"></label></div><button class="dark-btn">Save website details ↗</button></form></section>
<section class="dash-panel" id="menu"><div class="panel-heading"><div><span class="eyebrow">WHAT YOU SERVE</span><h2>Menu manager</h2><p>Add dishes, update prices, change photos or temporarily mark an item unavailable.</p></div></div><form method="post" action="/vendor/menu/add" enctype="multipart/form-data" class="add-menu-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><h3>Add a menu item</h3><div class="form-two"><label>Dish name<input name="name" required placeholder="e.g. Special roll"></label><label>Price (₹)<input name="price" placeholder="80"></label><label>Small label<input name="label" placeholder="HOUSE FAVOURITE"></label><label>Photo<input type="file" name="image" accept="image/png,image/jpeg,image/webp"></label></div><label>Description<textarea name="description" rows="2" placeholder="Tell customers what makes it special"></textarea></label><button class="dark-btn">Add to menu +</button></form><div class="menu-admin-list"><% items.forEach(item=>{ %><article class="menu-admin-item"><% if(item.image_url){ %><img src="<%= item.image_url %>" alt=""><% }else{ %><div class="menu-admin-placeholder"><%= item.name.charAt(0) %></div><% } %><form method="post" action="/vendor/menu/<%= item.id %>/update" enctype="multipart/form-data" class="menu-edit-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="form-two"><label>Name<input name="name" value="<%= item.name %>" required></label><label>Price<input name="price" value="<%= item.price %>"></label><label>Label<input name="label" value="<%= item.label %>"></label><label>Replace photo<input type="file" name="image" accept="image/png,image/jpeg,image/webp"></label></div><label>Description<textarea name="description" rows="2"><%= item.description %></textarea></label><label class="checkline"><input type="checkbox" name="available" <%= item.available?'checked':'' %>> Available on menu</label><button class="outline-btn">Save item</button></form><form method="post" action="/vendor/menu/<%= item.id %>/delete" onsubmit="return confirm('Remove this menu item?')"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="danger-btn">Delete</button></form></article><% }) %><% if(!items.length){ %><p class="empty-note">Your menu is empty. Add your first item above.</p><% } %></div></section>
<section class="dash-panel" id="reviews"><div class="panel-heading"><div><span class="eyebrow">CUSTOMER VOICES</span><h2>Reviews & feedback</h2><p>Only you and platform admins can see these responses.</p></div></div><% reviews.forEach(r=>{ %><article class="review-card"><div class="review-top"><div><b><%= r.customer_name||'Customer' %></b><small><%= r.visit_date||r.created_at %> · <%= r.visit_type %></small></div><strong><%= '★'.repeat(r.rating) %><span><%= r.rating %>/5</span></strong></div><div class="review-chips"><% r.ordered.forEach(d=>{ %><span><%= d %></span><% }) %></div><div class="review-detail-grid"><% Object.entries(r.answers).filter(([k,v])=>v&&k!=='name'&&k!=='visit_date'&&k!=='visit_type').forEach(([k,v])=>{ %><div><small><%= k.replaceAll('_',' ') %></small><p><%= v %></p></div><% }) %></div></article><% }) %><% if(!reviews.length){ %><p class="empty-note">No feedback yet. Your first customer response will appear here.</p><% } %></section>
<section class="dash-panel" id="account"><div class="panel-heading"><div><span class="eyebrow">ACCOUNT SECURITY</span><h2>Change your password</h2></div></div><form method="post" action="/vendor/password" class="portal-form narrow"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>New password (at least 10 characters)<input type="password" name="new_password" minlength="10" required></label><button class="outline-btn">Update password</button></form></section><footer class="dash-footer"><a href="/">← Main website</a><span>Neighbourhood Vendor Studio</span></footer></main></body></html>
